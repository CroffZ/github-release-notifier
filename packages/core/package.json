{
  "name": "@github-release-notifier/core",
  "version": "0.0.0",
  "private": true,
  "description": "Core release-to-pull-request notification engine contracts",
  "author": "Croff Zhong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CroffZ/github-release-notifier.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
