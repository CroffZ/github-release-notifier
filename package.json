{
  "name": "github-release-notifier-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Notify pull requests when they ship in a GitHub release",
  "author": "Croff Zhong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CroffZ/github-release-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/CroffZ/github-release-notifier/issues"
  },
  "homepage": "https://github.com/CroffZ/github-release-notifier#readme",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "corepack pnpm --recursive --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "corepack pnpm --recursive --if-present typecheck",
    "validate": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
